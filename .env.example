# Copy to .env at the workspace root (venus/.env also works for Venus and tests/live). Do not commit the filled file.
# Shell environment values take precedence over this file.

# Cala: one cached bulk pull feeds the dataset and the training cases (no free credits; reruns read app/data/cache).
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai

# App matching: mock uses fixtures; live calls Venus.
VENUS_MODE=mock
VENUS_STRATEGY=leadline-match-default

# Venus web search
CONTEXT_DEV_API_KEY=

# Model provider: Anthropic is the working provider (training uses the claude-research preset).
ANTHROPIC_API_KEY=
VENUS_TRAIN_PROVIDER=anthropic
# Presets default to claude-opus-5-5; e.g. VENUS_CLAUDE_FAST_MODEL=claude-haiku-5-5 to spend less on matching/trials.
# VENUS_CLAUDE_RESEARCH_MODEL=
# VENUS_CLAUDE_FAST_MODEL=
# VENUS_CLAUDE_EFFORT=medium

# Fallback: Verda (Kimi K3 Pro). Off until its credits are set up; then set VENUS_TRAIN_PROVIDER=verda.
# VERDA_API_KEY=
# VERDA_BASE_URL=https://inference.verda.com/v1
# VENUS_TRAIN_MODEL=kimi-k3-1-pro

# Off by default (kept for later): Meta Model API (auto-only tool choice), NVIDIA Build, Gemini.
# META_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=

# Real-call tests (tests/live): set per command, never here, or every test run spends credits.
#   VENUS_LIVE=1, plus VENUS_LIVE_VERDA / VENUS_LIVE_META / VENUS_LIVE_NVIDIA / VENUS_LIVE_GEMINI for off providers.
