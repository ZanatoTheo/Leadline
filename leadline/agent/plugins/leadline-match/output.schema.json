{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leadline-match/output.schema.json",
  "title": "leadline-match output: the body of app/contracts/match_result.schema.json (the app adds run_id, generated_at, request)",
  "type": "object",
  "required": [
    "matches",
    "rejected",
    "evidence",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "candidate_type",
          "rank",
          "score",
          "score_parts",
          "role",
          "active",
          "confidence",
          "reasons"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_type": {
            "enum": [
              "investor",
              "company"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score_parts": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "role": {
            "enum": [
              "lead",
              "participant",
              "unknown"
            ]
          },
          "active": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "last_lead_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "evidence"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reason",
          "detail"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "follower_only",
              "inactive",
              "stage_mismatch",
              "sector_mismatch",
              "size_mismatch",
              "out_of_region"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "dataset",
              "web"
            ]
          },
          "ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "fetched_at": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stats": {
      "type": "object"
    }
  }
}
