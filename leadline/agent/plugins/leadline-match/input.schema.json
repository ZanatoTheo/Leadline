{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leadline-match/input.schema.json",
  "title": "leadline-match input: one subject profile, its candidate profiles, and the request",
  "type": "object",
  "required": [
    "subject",
    "candidates",
    "request"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "$ref": "#/$defs/profile"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "request": {
      "type": "object",
      "required": [
        "direction",
        "top_k",
        "as_of"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "startup_to_investors",
            "investor_to_startups"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        }
      }
    }
  },
  "$defs": {
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "description": "A user profile as leadline-profile builds it. Unknown fields are null or absent, never guessed.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "startup",
            "investor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "$ref": "#/$defs/nullable_string"
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        },
        "country": {
          "$ref": "#/$defs/nullable_string"
        },
        "stage": {
          "$ref": "#/$defs/nullable_string",
          "description": "startup: its current stage"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "investor: stages it backs"
        },
        "sectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "check_size": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "lead_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "last_lead_date": {
          "$ref": "#/$defs/nullable_string"
        },
        "rating": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "dataset",
                  "web"
                ]
              },
              "ref": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "investor: countries or regions it invests in (e.g. Nordics, Europe, global)"
        },
        "raising": {
          "type": [
            "object",
            "null"
          ],
          "description": "startup: the round it is raising now",
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "direction": {
                "const": "startup_to_investors"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "startup"
              }
            }
          },
          "candidates": {
            "items": {
              "properties": {
                "kind": {
                  "const": "investor"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "direction": {
                "const": "investor_to_startups"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "investor"
              }
            }
          },
          "candidates": {
            "items": {
              "properties": {
                "kind": {
                  "const": "startup"
                }
              }
            }
          }
        }
      }
    }
  ]
}
