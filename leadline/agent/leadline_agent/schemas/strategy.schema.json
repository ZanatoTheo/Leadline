{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venus/strategy.schema.json",
  "title": "Venus strategy file (strategies/<id>.json)",
  "description": "A base model plus behavioral tendencies for one plugin version. Only status 'validated' may serve run requests.",
  "type": "object",
  "required": ["id", "plugin", "plugin_version", "status", "base_model", "tendencies", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "plugin": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["validated", "draft", "retired"]},
    "base_model": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "provider": {"enum": ["verda", "nvidia", "anthropic", "meta", "gemini"]},
        "base_url": {"type": "string", "pattern": "^https?://"},
        "key_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}
      },
      "additionalProperties": false
    },
    "tendencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
          "text": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
        },
        "additionalProperties": false
      }
    },
    "settings": {"type": "object", "description": "Typed knobs: core keys max_turns, max_web_calls; any other key must be declared in the plugin's settings_schema."},
    "created_at": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
