{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venus/request.schema.json",
  "title": "Venus request",
  "description": "Every request is either training (validated cases with expected outputs) or run (one input, a validated strategy). 'input' and 'expected' are checked further against the plugin's own schemas.",
  "oneOf": [
    {"$ref": "#/$defs/training"},
    {"$ref": "#/$defs/run"}
  ],
  "$defs": {
    "training": {
      "type": "object",
      "required": ["venus_version", "plugin", "mode", "cases"],
      "properties": {
        "venus_version": {"const": "1"},
        "plugin": {"type": "string", "minLength": 1},
        "mode": {"const": "training"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "input", "expected"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "input": {},
              "expected": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["venus_version", "plugin", "mode", "strategy", "input"],
      "properties": {
        "venus_version": {"const": "1"},
        "plugin": {"type": "string", "minLength": 1},
        "mode": {"const": "run"},
        "strategy": {"type": "string", "minLength": 1},
        "input": {}
      },
      "additionalProperties": false
    }
  }
}
