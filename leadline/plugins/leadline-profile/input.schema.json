{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leadline-profile/input.schema.json",
  "title": "leadline-profile input: raw user data, optional Cala facts, and optionally a current profile to update",
  "type": "object",
  "required": [
    "user"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "update": [
      "current"
    ]
  },
  "properties": {
    "user": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "startup",
            "investor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "description": "what the user filled in themselves"
        }
      }
    },
    "cala_facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object"
      },
      "description": "rows about this user from the cached Cala pull"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "ignore anything dated after this day"
    },
    "current": {
      "type": "object",
      "required": [
        "profile",
        "rating"
      ],
      "properties": {
        "profile": {
          "type": "object"
        },
        "rating": {
          "type": "object"
        }
      }
    },
    "update": {
      "type": "object",
      "required": [
        "reason",
        "new_info"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "new_info": {}
      }
    }
  }
}
