# Cala API key (https://console.cala.ai/api-keys).
# Without it, Leadline runs on simulated Cala responses (fictional companies
# and funds, clearly labelled "simulated data" in the UI).
CALA_API_KEY=

# Force simulated data even when a key is set (useful for offline demos).
# CALA_MODE=simulated

# Show the one-click founder/investor demo logins in production builds (npm start).
# They are always on in development (npm run dev).
# LEADLINE_DEMO_LOGIN=true

# Where the Leadline service (leadline/serve.py) runs. Default http://127.0.0.1:8765.
# In production: the Railway domain of the service, no trailing slash.
# LEADLINE_SERVICE_URL=

# Bearer token the service requires when it is exposed (its side gets the same
# value). Leave empty locally.
# LEADLINE_SERVICE_TOKEN=
