# Copy to .env and fill only the keys you have. Shell values take precedence.
# The app also finds a .env in the workspace root.

# Cala API key (https://docs.cala.ai). Only needed for live ingestion.
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai

# mock = serve fixture results; live = call Venus (requires the plugin and strategy).
VENUS_MODE=mock
VENUS_STRATEGY=cala-leads-default

# Venus web tools and model providers. Kimi K3 Pro (Verda) for research, Nemotron (NVIDIA) for trials and serving.
CONTEXT_DEV_API_KEY=
VERDA_API_KEY=
VERDA_BASE_URL=https://inference.verda.com/v1
NVIDIA_API_KEY=
# Research and proposing use Kimi K3 Pro on Verda (the default provider).
# Trials and serving use Nemotron on NVIDIA Build: set base_model {"model": "nemotron", "provider": "nvidia"} in the strategy.
VENUS_TRAIN_MODEL=kimi-k3-1-pro
