# Copy to .env and fill in. Never commit .env. Values already set in the shell win over this file.
# Venus finds .env by walking up from the current folder, or reads the file named in VENUS_ENV_FILE.

# Verda (default provider). Base URL of the OpenAI-compatible endpoint, e.g. https://.../v1
VERDA_API_KEY=
VERDA_BASE_URL=

# NVIDIA Build (fallback provider, https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=

# Model ids for the presets (defaults: NVIDIA Build ids). Check with tools/models_probe.py.
VENUS_NEMOTRON_MODEL=
VENUS_GEMMA_MODEL=

# Context.dev web tools (code JUNCTION26). CONTEXTDEV_API_KEY is also accepted.
CONTEXT_DEV_API_KEY=
