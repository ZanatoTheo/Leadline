{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venus/plugin.schema.json",
  "title": "Venus plugin manifest (plugin.json)",
  "type": "object",
  "required": ["name", "version", "brief", "input_schema", "output_schema", "checker"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "brief": {"type": "string", "minLength": 1},
    "input_schema": {"$ref": "#/$defs/relative_file"},
    "output_schema": {"$ref": "#/$defs/relative_file"},
    "checker": {"$ref": "#/$defs/callable_ref"},
    "tools": {"$ref": "#/$defs/callable_ref"},
    "settings_schema": {"oneOf": [{"$ref": "#/$defs/relative_file"}, {"type": "object"}], "description": "JSON Schema (a file in the plugin folder, or inline) for the plugin's own strategy settings."},
    "web": {"type": "boolean", "default": true, "description": "Built-in web tools (Context.dev). On unless false."},
    "cala": {"type": "boolean", "default": false, "description": "Built-in Cala tools (run mode only, never in training). Off unless true."},
    "seed_tendencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/tendency"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relative_file": {
      "description": "A path inside the plugin folder: no leading slash, no '..' parts.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"
    },
    "callable_ref": {
      "description": "module:function, where module is a .py file in the plugin folder (dots = subfolders).",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "tendency": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "text": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
      },
      "additionalProperties": false
    }
  }
}
