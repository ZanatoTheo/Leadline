{
  "$ref": "#/definitions/SessionUser",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FounderProfile": {
      "additionalProperties": false,
      "properties": {
        "competitors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "customers": {
          "description": "Who the startup sells to, e.g. \"mid-size manufacturers\".",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "oneLiner": {
          "type": "string"
        },
        "raiseEurM": {
          "type": "number"
        },
        "region": {
          "$ref": "#/definitions/Region"
        },
        "sector": {
          "$ref": "#/definitions/Sector"
        },
        "stage": {
          "$ref": "#/definitions/Stage"
        },
        "startupName": {
          "type": "string"
        }
      },
      "required": [
        "startupName",
        "oneLiner",
        "sector",
        "stage",
        "location",
        "region",
        "raiseEurM",
        "competitors",
        "customers"
      ],
      "type": "object"
    },
    "Region": {
      "enum": [
        "europe",
        "nordics",
        "uk",
        "dach"
      ],
      "type": "string"
    },
    "Role": {
      "enum": [
        "founder",
        "investor"
      ],
      "type": "string"
    },
    "Sector": {
      "enum": [
        "climate",
        "fintech",
        "ai",
        "health",
        "saas"
      ],
      "type": "string"
    },
    "SessionUser": {
      "additionalProperties": false,
      "description": "What the browser is allowed to know about the logged-in user.",
      "properties": {
        "discoverable": {
          "type": "boolean"
        },
        "email": {
          "type": "string"
        },
        "founderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "investorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/definitions/FounderProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/definitions/Role"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "email",
        "investorName",
        "founderId",
        "profile",
        "discoverable"
      ],
      "type": "object"
    },
    "Stage": {
      "enum": [
        "pre-seed",
        "seed",
        "series-a",
        "series-b"
      ],
      "type": "string"
    }
  }
}