{
  "$ref": "#/definitions/InvestorBrief",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CoInvestor": {
      "additionalProperties": false,
      "properties": {
        "deals": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "of": {
          "type": "number"
        },
        "together": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "together",
        "of",
        "deals"
      ],
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/ConflictLevel"
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "sources"
      ],
      "type": "object"
    },
    "ConflictLevel": {
      "enum": [
        "none",
        "possible",
        "direct"
      ],
      "type": "string"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "FundClose": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "string"
        },
        "fundName": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "sizeEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "investor",
        "fundName",
        "sizeEurM",
        "closed",
        "sources"
      ],
      "type": "object"
    },
    "InvestorBrief": {
      "additionalProperties": false,
      "properties": {
        "coInvestors": {
          "items": {
            "$ref": "#/definitions/CoInvestor"
          },
          "type": "array"
        },
        "investor": {
          "$ref": "#/definitions/RankedInvestor"
        },
        "of": {
          "type": "number"
        },
        "portfolio": {
          "items": {
            "$ref": "#/definitions/PortfolioCompany"
          },
          "type": "array"
        },
        "rank": {
          "type": "number"
        },
        "synergies": {
          "items": {
            "$ref": "#/definitions/Synergy"
          },
          "type": "array"
        },
        "timing": {
          "$ref": "#/definitions/Timing"
        },
        "twinsLed": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        }
      },
      "required": [
        "investor",
        "rank",
        "of",
        "twinsLed",
        "timing",
        "synergies",
        "coInvestors",
        "portfolio"
      ],
      "type": "object"
    },
    "PortfolioCompany": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "industry",
        "sources"
      ],
      "type": "object"
    },
    "RankedInvestor": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "$ref": "#/definitions/Conflict"
        },
        "explanation": {
          "type": "string"
        },
        "joinedCount": {
          "type": "number"
        },
        "joinedDeals": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "lastLed": {
          "type": [
            "string",
            "null"
          ]
        },
        "leadShare": {
          "type": "number"
        },
        "ledCount": {
          "type": "number"
        },
        "ledDeals": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "slug": {
          "type": "string"
        },
        "synergyCount": {
          "type": "number"
        },
        "timingHeadline": {
          "type": "string"
        },
        "timingStatus": {
          "$ref": "#/definitions/TimingStatus"
        },
        "twinsLedCount": {
          "description": "Filled in for the top of the shortlist.",
          "type": "number"
        }
      },
      "required": [
        "name",
        "slug",
        "score",
        "ledCount",
        "joinedCount",
        "lastLed",
        "leadShare",
        "ledDeals",
        "joinedDeals",
        "conflict",
        "explanation"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    },
    "Synergy": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "matched": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "industry",
        "matched",
        "sources"
      ],
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "avgLeadsPer90": {
          "type": "number"
        },
        "daysSinceLastLead": {
          "type": [
            "number",
            "null"
          ]
        },
        "headline": {
          "type": "string"
        },
        "latestFund": {
          "anyOf": [
            {
              "$ref": "#/definitions/FundClose"
            },
            {
              "type": "null"
            }
          ]
        },
        "leadsLast90": {
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/TimingStatus"
        }
      },
      "required": [
        "status",
        "headline",
        "latestFund",
        "leadsLast90",
        "avgLeadsPer90",
        "daysSinceLastLead",
        "reasons"
      ],
      "type": "object"
    },
    "TimingStatus": {
      "description": "\"unknown\": no leads in the data and no fresh fund, so the pace can't be judged.",
      "enum": [
        "deploying",
        "steady",
        "slowing",
        "unknown"
      ],
      "type": "string"
    }
  }
}