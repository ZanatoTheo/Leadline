{
  "$ref": "#/definitions/CompanyDiligence",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CompanyDiligence": {
      "additionalProperties": false,
      "description": "An investor's view of a startup found in Cala (not on Leadline).",
      "properties": {
        "backers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "joined": {
                "type": "number"
              },
              "led": {
                "type": "number"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "led",
              "joined"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ],
          "type": "string"
        },
        "monthsSinceLast": {
          "type": [
            "number",
            "null"
          ]
        },
        "raisingSoon": {
          "type": "boolean"
        },
        "risks": {
          "items": {
            "$ref": "#/definitions/DiligencePoint"
          },
          "type": "array"
        },
        "rounds": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "similar": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "company": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "inYourPortfolio": {
                "type": "boolean"
              },
              "rounds": {
                "items": {
                  "$ref": "#/definitions/Deal"
                },
                "type": "array"
              }
            },
            "required": [
              "company",
              "description",
              "rounds",
              "inYourPortfolio"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "strengths": {
          "items": {
            "$ref": "#/definitions/DiligencePoint"
          },
          "type": "array"
        },
        "youBacked": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "company",
        "description",
        "industry",
        "rounds",
        "backers",
        "monthsSinceLast",
        "raisingSoon",
        "youBacked",
        "similar",
        "strengths",
        "risks"
      ],
      "type": "object"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "DiligencePoint": {
      "additionalProperties": false,
      "description": "A point for or against investing, with the evidence behind it.",
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "sources"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    }
  }
}