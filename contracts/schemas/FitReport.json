{
  "$ref": "#/definitions/FitReport",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/ConflictLevel"
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "sources"
      ],
      "type": "object"
    },
    "ConflictLevel": {
      "enum": [
        "none",
        "possible",
        "direct"
      ],
      "type": "string"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "FitReport": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "$ref": "#/definitions/Conflict"
        },
        "headline": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "points": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "string"
              },
              "good": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "sources": {
                "items": {
                  "$ref": "#/definitions/Source"
                },
                "type": "array"
              }
            },
            "required": [
              "label",
              "good",
              "detail",
              "sources"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "portfolioTwins": {
          "items": {
            "$ref": "#/definitions/PortfolioTwin"
          },
          "type": "array"
        },
        "score": {
          "type": "number"
        },
        "stage": {
          "additionalProperties": false,
          "properties": {
            "ledAtStage": {
              "type": "number"
            },
            "maxEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "medianEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "minEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "raiseFits": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "ledAtStage",
            "minEurM",
            "maxEurM",
            "medianEurM",
            "raiseFits"
          ],
          "type": "object"
        },
        "synergies": {
          "items": {
            "$ref": "#/definitions/Synergy"
          },
          "type": "array"
        },
        "timing": {
          "$ref": "#/definitions/Timing"
        }
      },
      "required": [
        "investor",
        "score",
        "headline",
        "portfolioTwins",
        "stage",
        "conflict",
        "synergies",
        "timing",
        "points"
      ],
      "type": "object"
    },
    "FundClose": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "string"
        },
        "fundName": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "sizeEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "investor",
        "fundName",
        "sizeEurM",
        "closed",
        "sources"
      ],
      "type": "object"
    },
    "PortfolioTwin": {
      "additionalProperties": false,
      "description": "A portfolio company that looks like the founder, with what happened next.",
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rounds": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "rounds"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    },
    "Synergy": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "matched": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "industry",
        "matched",
        "sources"
      ],
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "avgLeadsPer90": {
          "type": "number"
        },
        "daysSinceLastLead": {
          "type": [
            "number",
            "null"
          ]
        },
        "headline": {
          "type": "string"
        },
        "latestFund": {
          "anyOf": [
            {
              "$ref": "#/definitions/FundClose"
            },
            {
              "type": "null"
            }
          ]
        },
        "leadsLast90": {
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/TimingStatus"
        }
      },
      "required": [
        "status",
        "headline",
        "latestFund",
        "leadsLast90",
        "avgLeadsPer90",
        "daysSinceLastLead",
        "reasons"
      ],
      "type": "object"
    },
    "TimingStatus": {
      "description": "\"unknown\": no leads in the data and no fresh fund, so the pace can't be judged.",
      "enum": [
        "deploying",
        "steady",
        "slowing",
        "unknown"
      ],
      "type": "string"
    }
  }
}