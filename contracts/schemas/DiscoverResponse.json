{
  "$ref": "#/definitions/DiscoverResponse",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/ConflictLevel"
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "sources"
      ],
      "type": "object"
    },
    "ConflictLevel": {
      "enum": [
        "none",
        "possible",
        "direct"
      ],
      "type": "string"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "DiscoverResponse": {
      "additionalProperties": false,
      "properties": {
        "founders": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "fit": {
                "$ref": "#/definitions/FitReport"
              },
              "founder": {
                "$ref": "#/definitions/PublicFounder"
              },
              "intro": {
                "$ref": "#/definitions/Intro"
              }
            },
            "required": [
              "founder",
              "fit"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ],
          "type": "string"
        },
        "nextTwins": {
          "items": {
            "$ref": "#/definitions/NextTwin"
          },
          "type": "array"
        },
        "ranking": {
          "description": "Set while this fund has no stored ranking yet: the agent is still building it, or the build failed.",
          "enum": [
            "building",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "founders",
        "nextTwins"
      ],
      "type": "object"
    },
    "FitReport": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "$ref": "#/definitions/Conflict"
        },
        "headline": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "points": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "string"
              },
              "good": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "sources": {
                "items": {
                  "$ref": "#/definitions/Source"
                },
                "type": "array"
              }
            },
            "required": [
              "label",
              "good",
              "detail",
              "sources"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "portfolioTwins": {
          "items": {
            "$ref": "#/definitions/PortfolioTwin"
          },
          "type": "array"
        },
        "score": {
          "type": "number"
        },
        "stage": {
          "additionalProperties": false,
          "properties": {
            "ledAtStage": {
              "type": "number"
            },
            "maxEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "medianEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "minEurM": {
              "type": [
                "number",
                "null"
              ]
            },
            "raiseFits": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "ledAtStage",
            "minEurM",
            "maxEurM",
            "medianEurM",
            "raiseFits"
          ],
          "type": "object"
        },
        "synergies": {
          "items": {
            "$ref": "#/definitions/Synergy"
          },
          "type": "array"
        },
        "timing": {
          "$ref": "#/definitions/Timing"
        }
      },
      "required": [
        "investor",
        "score",
        "headline",
        "portfolioTwins",
        "stage",
        "conflict",
        "synergies",
        "timing",
        "points"
      ],
      "type": "object"
    },
    "FounderProfile": {
      "additionalProperties": false,
      "properties": {
        "competitors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "customers": {
          "description": "Who the startup sells to, e.g. \"mid-size manufacturers\".",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "oneLiner": {
          "type": "string"
        },
        "raiseEurM": {
          "type": "number"
        },
        "region": {
          "$ref": "#/definitions/Region"
        },
        "sector": {
          "$ref": "#/definitions/Sector"
        },
        "stage": {
          "$ref": "#/definitions/Stage"
        },
        "startupName": {
          "type": "string"
        }
      },
      "required": [
        "startupName",
        "oneLiner",
        "sector",
        "stage",
        "location",
        "region",
        "raiseEurM",
        "competitors",
        "customers"
      ],
      "type": "object"
    },
    "FundClose": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "string"
        },
        "fundName": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "sizeEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "investor",
        "fundName",
        "sizeEurM",
        "closed",
        "sources"
      ],
      "type": "object"
    },
    "Intro": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "founder-to-investor",
            "investor-to-founder"
          ],
          "type": "string"
        },
        "founderId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "passReason": {
          "type": "string"
        },
        "respondedAt": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/IntroStatus"
        }
      },
      "required": [
        "id",
        "founderId",
        "investor",
        "direction",
        "note",
        "status",
        "createdAt"
      ],
      "type": "object"
    },
    "IntroStatus": {
      "enum": [
        "pending",
        "accepted",
        "passed"
      ],
      "type": "string"
    },
    "NextTwin": {
      "additionalProperties": false,
      "properties": {
        "backers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "lastRound": {
          "$ref": "#/definitions/Deal"
        },
        "looksLike": {
          "type": "string"
        },
        "monthsSinceLast": {
          "type": "number"
        },
        "raisingSoon": {
          "type": "boolean"
        },
        "rounds": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "looksLike",
        "rounds",
        "lastRound",
        "monthsSinceLast",
        "raisingSoon",
        "backers"
      ],
      "type": "object"
    },
    "PortfolioTwin": {
      "additionalProperties": false,
      "description": "A portfolio company that looks like the founder, with what happened next.",
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rounds": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "rounds"
      ],
      "type": "object"
    },
    "PublicFounder": {
      "additionalProperties": false,
      "description": "What the investor sees about a founder (no contact details until matched).",
      "properties": {
        "founderName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/definitions/FounderProfile"
        }
      },
      "required": [
        "id",
        "profile",
        "founderName"
      ],
      "type": "object"
    },
    "Region": {
      "enum": [
        "europe",
        "nordics",
        "uk",
        "dach"
      ],
      "type": "string"
    },
    "Sector": {
      "enum": [
        "climate",
        "fintech",
        "ai",
        "health",
        "saas"
      ],
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    },
    "Stage": {
      "enum": [
        "pre-seed",
        "seed",
        "series-a",
        "series-b"
      ],
      "type": "string"
    },
    "Synergy": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "matched": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "company",
        "description",
        "industry",
        "matched",
        "sources"
      ],
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "avgLeadsPer90": {
          "type": "number"
        },
        "daysSinceLastLead": {
          "type": [
            "number",
            "null"
          ]
        },
        "headline": {
          "type": "string"
        },
        "latestFund": {
          "anyOf": [
            {
              "$ref": "#/definitions/FundClose"
            },
            {
              "type": "null"
            }
          ]
        },
        "leadsLast90": {
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/TimingStatus"
        }
      },
      "required": [
        "status",
        "headline",
        "latestFund",
        "leadsLast90",
        "avgLeadsPer90",
        "daysSinceLastLead",
        "reasons"
      ],
      "type": "object"
    },
    "TimingStatus": {
      "description": "\"unknown\": no leads in the data and no fresh fund, so the pace can't be judged.",
      "enum": [
        "deploying",
        "steady",
        "slowing",
        "unknown"
      ],
      "type": "string"
    }
  }
}