{
  "$ref": "#/definitions/SignalsResponse",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/ConflictLevel"
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "sources"
      ],
      "type": "object"
    },
    "ConflictLevel": {
      "enum": [
        "none",
        "possible",
        "direct"
      ],
      "type": "string"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "FundClose": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "string"
        },
        "fundName": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "sizeEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "investor",
        "fundName",
        "sizeEurM",
        "closed",
        "sources"
      ],
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "$ref": "#/definitions/Conflict"
        },
        "daysAgo": {
          "type": "number"
        },
        "deal": {
          "$ref": "#/definitions/Deal"
        },
        "fund": {
          "$ref": "#/definitions/FundClose"
        },
        "id": {
          "type": "string"
        },
        "investor": {
          "type": "string"
        },
        "investorSlug": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "lead",
            "fund"
          ],
          "type": "string"
        },
        "synergyCount": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "investor",
        "investorSlug",
        "daysAgo",
        "conflict"
      ],
      "type": "object"
    },
    "SignalsResponse": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ],
          "type": "string"
        },
        "signals": {
          "items": {
            "$ref": "#/definitions/Signal"
          },
          "type": "array"
        }
      },
      "required": [
        "mode",
        "checkedAt",
        "signals"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    }
  }
}