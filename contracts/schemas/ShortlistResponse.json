{
  "$ref": "#/definitions/ShortlistResponse",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/ConflictLevel"
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "sources"
      ],
      "type": "object"
    },
    "ConflictLevel": {
      "enum": [
        "none",
        "possible",
        "direct"
      ],
      "type": "string"
    },
    "Deal": {
      "additionalProperties": false,
      "properties": {
        "amountEurM": {
          "type": [
            "number",
            "null"
          ]
        },
        "announced": {
          "type": "string"
        },
        "calaEntityId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "companyDescription": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "leadInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "otherInvestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "companyDescription",
        "industry",
        "round",
        "amountEurM",
        "announced",
        "leadInvestors",
        "otherInvestors",
        "sources"
      ],
      "type": "object"
    },
    "RankedInvestor": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "$ref": "#/definitions/Conflict"
        },
        "explanation": {
          "type": "string"
        },
        "joinedCount": {
          "type": "number"
        },
        "joinedDeals": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "lastLed": {
          "type": [
            "string",
            "null"
          ]
        },
        "leadShare": {
          "type": "number"
        },
        "ledCount": {
          "type": "number"
        },
        "ledDeals": {
          "items": {
            "$ref": "#/definitions/Deal"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "slug": {
          "type": "string"
        },
        "synergyCount": {
          "type": "number"
        },
        "timingHeadline": {
          "type": "string"
        },
        "timingStatus": {
          "$ref": "#/definitions/TimingStatus"
        },
        "twinsLedCount": {
          "description": "Filled in for the top of the shortlist.",
          "type": "number"
        }
      },
      "required": [
        "name",
        "slug",
        "score",
        "ledCount",
        "joinedCount",
        "lastLed",
        "leadShare",
        "ledDeals",
        "joinedDeals",
        "conflict",
        "explanation"
      ],
      "type": "object"
    },
    "ShortlistResponse": {
      "additionalProperties": false,
      "properties": {
        "fetchedAt": {
          "type": "string"
        },
        "investors": {
          "items": {
            "$ref": "#/definitions/RankedInvestor"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ],
          "type": "string"
        },
        "roundsAnalysed": {
          "type": "number"
        },
        "sourcesCited": {
          "type": "number"
        }
      },
      "required": [
        "mode",
        "fetchedAt",
        "roundsAnalysed",
        "sourcesCited",
        "investors"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A document Cala cites for a claim.",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "type": "object"
    },
    "TimingStatus": {
      "description": "\"unknown\": no leads in the data and no fresh fund, so the pace can't be judged.",
      "enum": [
        "deploying",
        "steady",
        "slowing",
        "unknown"
      ],
      "type": "string"
    }
  }
}